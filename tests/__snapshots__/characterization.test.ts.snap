                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
        },
        "summary": "Start a password reset",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/login": {
      "post": {
        "description": "Verifies the credentials of a confirmed account and starts a new session for this device. The session lives only in the cookie: the signed-in user is read from GET /me. The error response is intentionally generic and identical whether the email is unknown or the password is wrong. Repeated failures for the same email are throttled, and the 429 carries Retry-After in seconds.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "format": "email",
                    "maxLength": 254,
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string",
                  },
                  "password": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "email",
                  "password",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "204": {
            "description": "No content.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
        },
        "summary": "Sign in with email and password",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/resend-code": {
      "post": {
        "description": "Issues a fresh confirmation code for the unconfirmed account identified by the signup_session cookie. Guarded by a per-signup cooldown and a total send cap.",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
