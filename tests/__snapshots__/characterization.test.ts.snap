            "description": "Default Response",
          },
        },
        "summary": "Resend the signup confirmation code",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/reset-password": {
      "post": {
        "description": "Verifies the 6-digit code for the reset identified by the password_reset cookie, stores the new password, ends every session of the account and starts a new one. Everything about the code answers with the same generic 401, because telling the cases apart would reveal which addresses have accounts.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "code": {
                    "pattern": "^\\d{6}$",
                    "type": "string",
                  },
                  "newPassword": {
                    "maxLength": 128,
                    "minLength": 15,
                    "type": "string",
                  },
                },
                "required": [
                  "code",
                  "newPassword",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "204": {
            "description": "No content.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Default Response",
          },
        },
        "summary": "Finish a password reset and sign in",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/signup": {
      "post": {
        "description": "Creates an unconfirmed account, or gives an unconfirmed one the new password, and emails a 6-digit confirmation code. The response is intentionally generic and identical whether or not the email is already registered, and the code is delivered outside the request so the two cases cannot be told apart by how long the response takes.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "format": "email",
                    "maxLength": 254,
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string",
                  },
                  "password": {
                    "maxLength": 128,
                    "minLength": 15,
                    "type": "string",
                  },
                },
                "required": [
                  "email",
                  "password",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                  },
                  "required": [
