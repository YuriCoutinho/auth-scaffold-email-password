# Linear — copy to .env and fill in
LINEAR_API_KEY=
LINEAR_TEAM_KEY=
LINEAR_PROJECT=

# App
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_scaffold
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=
EMAIL_DRIVER=mailpit
EMAIL_FROM="Auth Scaffold <onboarding@resend.dev>"
# Only required when EMAIL_DRIVER=resend; create a send-only key in the Resend dashboard
RESEND_API_KEY=

# At least 32 random characters, e.g. openssl rand -hex 32
HMAC_SECRET=
